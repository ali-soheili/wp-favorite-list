msgid "Repository, branch or release not found. If the repository is private, add an access token."
msgstr "مخزن، شاخه یا انتشار پیدا نشد. اگر مخزن خصوصی است، توکن دسترسی را وارد کنید."

msgid "The GitHub access token is invalid or expired."
msgstr "توکن دسترسی گیت‌هاب نامعتبر است یا منقضی شده است."

msgid "GitHub API rate limit reached. Try again later or add an access token."
msgstr "به سقف درخواست‌های API گیت‌هاب رسیدید. بعداً دوباره تلاش کنید یا توکن دسترسی وارد کنید."

msgid "GitHub returned HTTP %1$d. %2$s"
msgstr "گیت‌هاب کد HTTP %1$d برگرداند. %2$s"

msgid "Checking GitHub for updates is turned off."
msgstr "بررسی به‌روزرسانی از گیت‌هاب خاموش است."

msgid "Outgoing requests to GitHub are blocked on this site (WP_HTTP_BLOCK_EXTERNAL)."
msgstr "درخواست‌های خروجی به گیت‌هاب در این سایت مسدود است (WP_HTTP_BLOCK_EXTERNAL)."

msgid "Could not read the Version header from the plugin file on GitHub."
msgstr "خواندن شماره نسخه از فایل افزونه در گیت‌هاب ممکن نشد."

msgid "Recent changes"
msgstr "تغییرات اخیر"

msgid "No published release found on GitHub."
msgstr "هیچ انتشار منتشرشده‌ای در گیت‌هاب پیدا نشد."

msgid "View on GitHub"
msgstr "مشاهده در گیت‌هاب"

msgid "See the GitHub repository for changes."
msgstr "برای دیدن تغییرات به مخزن گیت‌هاب مراجعه کنید."

msgid "GitHub did not return a download location."
msgstr "گیت‌هاب آدرس دانلود را برنگرداند."

msgid "Could not save the downloaded update."
msgstr "ذخیره به‌روزرسانی دانلودشده ممکن نشد."

msgid "Download from GitHub failed (HTTP %d)."
msgstr "دانلود از گیت‌هاب ناموفق بود (HTTP %d)."

msgid "The downloaded package does not contain the Favorite List plugin file."
msgstr "بسته دانلودشده فایل افزونه لیست علاقه مندی را ندارد."

msgid "Could not rename the update folder."
msgstr "تغییر نام پوشه به‌روزرسانی ممکن نشد."

msgid "Check for updates"
msgstr "بررسی به‌روزرسانی"

msgid "Favorite List"
msgstr "لیست علاقه مندی"

msgid "Settings"
msgstr "تنظیمات"

msgid "Choose icon"
msgstr "انتخاب آیکون"

msgid "Use this icon"
msgstr "استفاده از این آیکون"

msgid "Copied!"
msgstr "کپی شد!"

msgid "Copy"
msgstr "کپی"

msgid "General"
msgstr "عمومی"

msgid "How to use"
msgstr "راهنمای استفاده"

msgid "Updates"
msgstr "به‌روزرسانی"

msgid "Update settings saved."
msgstr "تنظیمات به‌روزرسانی ذخیره شد."

msgid "Checked GitHub for updates."
msgstr "به‌روزرسانی‌ها از گیت‌هاب بررسی شد."

msgid "Normal icon"
msgstr "آیکون عادی"

msgid "Shown when the post is not in the user’s favorites."
msgstr "وقتی نوشته در لیست علاقه مندی کاربر نیست نمایش داده می‌شود."

msgid "Active icon"
msgstr "آیکون فعال"

msgid "Shown when the post is in the user’s favorites."
msgstr "وقتی نوشته در لیست علاقه مندی کاربر است نمایش داده می‌شود."

msgid "Settings saved."
msgstr "تنظیمات ذخیره شد."

msgid "Icons"
msgstr "آیکون‌ها"

msgid "Media Library"
msgstr "کتابخانه رسانه"

msgid "Visitors who are not logged in"
msgstr "بازدیدکنندگانی که وارد نشده‌اند"

msgid "Redirect to"
msgstr "انتقال به"

msgid "Only logged-in users can use the favorites list. Visitors who click the icon are sent to this address."
msgstr "فقط کاربران واردشده می‌توانند از لیست علاقه مندی استفاده کنند. بازدیدکنندگانی که روی آیکون کلیک کنند به این آدرس منتقل می‌شوند."

msgid "Leave empty to use the WordPress login page; after logging in they come back to the same post."
msgstr "برای استفاده از صفحه ورود وردپرس خالی بگذارید؛ بعد از ورود به همان نوشته برمی‌گردند."

msgid "Use %s in the address to insert the page the visitor was on, e.g."
msgstr "برای قرار دادن آدرس صفحه‌ای که بازدیدکننده در آن بود از %s در آدرس استفاده کنید، مثلاً"

msgid "line %d"
msgstr "خط %d"

msgid "2. Create the favorites page"
msgstr "۲. ساخت صفحه لیست علاقه مندی"

msgid "Create a page (e.g. “My favorites”) and put this shortcode in it. It lists the user’s favorite posts, each with a heart to remove it."
msgstr "یک برگه بسازید (مثلاً «علاقه مندی‌های من») و این کد کوتاه را در آن قرار دهید. نوشته‌های مورد علاقه کاربر را نمایش می‌دهد و هر کدام یک قلب برای حذف دارد."

msgid "Add a new page"
msgstr "افزودن برگه جدید"

msgid "How many users added the current post to their favorites."
msgstr "تعداد کاربرانی که این نوشته را به لیست علاقه مندی اضافه کرده‌اند."

msgid "Array of the current user’s favorite post IDs, for custom templates."
msgstr "آرایه شناسه نوشته‌های مورد علاقه کاربر فعلی، برای قالب‌های سفارشی."

msgid "Update status"
msgstr "وضعیت به‌روزرسانی"

msgid "Installed version"
msgstr "نسخه نصب‌شده"

msgid "Latest version on GitHub"
msgstr "آخرین نسخه در گیت‌هاب"

msgid "Update checks are turned off."
msgstr "بررسی به‌روزرسانی خاموش است."

msgid "Update now"
msgstr "به‌روزرسانی"

msgid "You are up to date."
msgstr "افزونه به‌روز است."

msgid "Not checked yet."
msgstr "هنوز بررسی نشده است."

msgid "Last checked %s ago."
msgstr "آخرین بررسی: %s پیش."

msgid "Check for updates now"
msgstr "بررسی به‌روزرسانی"

msgid "GitHub source"
msgstr "منبع گیت‌هاب"

msgid "Update checks"
msgstr "بررسی به‌روزرسانی"

msgid "Check GitHub for new versions"
msgstr "بررسی نسخه‌های جدید در گیت‌هاب"

msgid "Turn this off on sites without internet access (e.g. a private network). The plugin works fully without it."
msgstr "در سایت‌های بدون دسترسی به اینترنت (مثلاً شبکه داخلی) این گزینه را خاموش کنید. افزونه بدون آن کاملاً کار می‌کند."

msgid "Repository"
msgstr "مخزن"

msgid "Format: owner/repository"
msgstr "قالب: owner/repository"

msgid "Update source"
msgstr "منبع به‌روزرسانی"

msgid "Branch: offer an update whenever the Version in the plugin file on the branch is higher"
msgstr "شاخه: هر وقت نسخه فایل افزونه در شاخه بالاتر بود، به‌روزرسانی پیشنهاد شود"

msgid "Releases: offer an update only when a new GitHub Release is published"
msgstr "انتشارها: فقط وقتی یک Release جدید در گیت‌هاب منتشر شد، به‌روزرسانی پیشنهاد شود"

msgid "Branch"
msgstr "شاخه"

msgid "Access token"
msgstr "توکن دسترسی"

msgid "Saved — leave empty to keep"
msgstr "ذخیره شده — برای حفظ آن خالی بگذارید"

msgid "Remove saved token"
msgstr "حذف توکن ذخیره‌شده"

msgid "Only needed if the repository is private. Use a fine-grained token with read-only “Contents” access to this repository."
msgstr "فقط برای مخزن خصوصی لازم است. یک توکن fine-grained با دسترسی فقط‌خواندنی «Contents» به این مخزن بسازید."

msgid "Save Changes"
msgstr "ذخیره تغییرات"

msgid "Sorry, you are not allowed to update plugins."
msgstr "شما اجازه به‌روزرسانی افزونه‌ها را ندارید."

msgid "Favorites"
msgstr "لیست علاقه مندی"

msgid "Add to favorites"
msgstr "افزودن به لیست علاقه مندی"

msgid "Remove from favorites"
msgstr "حذف از لیست علاقه مندی"

msgid "Log in to use your favorites list"
msgstr "برای استفاده از لیست علاقه مندی وارد حساب کاربری خود شوید"

msgid "You haven’t added anything to your favorites yet."
msgstr "هنوز مطلبی به لیست علاقه مندی اضافه نکرده‌اید."

msgid "Log in to see your favorites list."
msgstr "برای دیدن لیست علاقه مندی خود ابتدا وارد شوید."

msgid "Log in"
msgstr "ورود به حساب کاربری"

msgid "Button"
msgstr "دکمه"

msgid "Button text"
msgstr "متن دکمه"

msgid "Text shown next to the icon. Leave empty for the default."
msgstr "متنی که کنار آیکون نمایش داده می‌شود. برای متن پیش‌فرض خالی بگذارید."

msgid "Icon size"
msgstr "اندازه آیکون"

msgid "Width"
msgstr "عرض"

msgid "Height"
msgstr "ارتفاع"

msgid "px"
msgstr "پیکسل"

msgid "Leave empty to use the plugin’s default heart icon."
msgstr "برای استفاده از آیکون قلب پیش‌فرض افزونه خالی بگذارید."

msgid "The favorite button is in your theme:"
msgstr "دکمه علاقه مندی در این قسمت‌های پوسته شما قرار دارد:"

msgid "The favorite button hasn’t been added to your theme yet."
msgstr "دکمه علاقه مندی هنوز به پوسته شما اضافه نشده است."

msgid "Follow step 1 below, or use the shortcode inside your posts."
msgstr "مرحله ۱ را دنبال کنید یا از کد کوتاه داخل نوشته‌ها استفاده کنید."

msgid "1. Show the favorite button"
msgstr "۱. نمایش دکمه علاقه مندی"

msgid "Place this code in your theme where you want the button to appear:"
msgstr "این کد را در هر جای پوسته که می‌خواهید دکمه نمایش داده شود قرار دهید:"

msgid "Put it inside the post loop. The usual place is the single post template: single.php, or a template part it loads such as template-parts/content-single.php. It also works in archive and blog templates, showing a button for each post."
msgstr "کد را داخل حلقه نوشته قرار دهید. معمولاً جای آن قالب صفحه نوشته است: single.php یا بخشی که در آن فراخوانی می‌شود، مثل template-parts/content-single.php. در قالب‌های آرشیو و وبلاگ هم کار می‌کند و برای هر نوشته یک دکمه نمایش می‌دهد."

msgid "If your theme already has a favorite or bookmark icon, replace that link with this code."
msgstr "اگر پوسته شما از قبل آیکون علاقه مندی یا نشانک دارد، آن لینک را با این کد جایگزین کنید."

msgid "Your active theme folder:"
msgstr "پوشه پوسته فعال شما:"

msgid "Use a child theme if you can, so a theme update doesn’t remove the code."
msgstr "در صورت امکان از پوسته فرزند استفاده کنید تا با به‌روزرسانی پوسته، کد حذف نشود."

msgid "The button uses the text, icons and size from the General tab, and shows the right state for the logged-in user."
msgstr "دکمه از متن، آیکون‌ها و اندازه تب «عمومی» استفاده می‌کند و وضعیت درست را برای کاربر واردشده نمایش می‌دهد."

msgid "No access to theme files?"
msgstr "به فایل‌های پوسته دسترسی ندارید؟"

msgid "Add this shortcode to a post, or to a widget or block template (Shortcode block):"
msgstr "این کد کوتاه را در یک نوشته، ابزارک یا قالب بلوکی (بلوک کد کوتاه) قرار دهید:"

msgid "Customize the button"
msgstr "سفارشی‌سازی دکمه"

msgid "Icon only, without text:"
msgstr "فقط آیکون، بدون متن:"

msgid "Different text and an extra CSS class:"
msgstr "متن دیگر و یک کلاس CSS اضافه:"

msgid "A button for a specific post (outside the loop):"
msgstr "دکمه برای یک نوشته مشخص (بیرون از حلقه):"

msgid "Your own HTML: give any link or button the class fl-favorite-btn and the post ID. The plugin handles the click and swaps the image inside it."
msgstr "HTML دلخواه: به هر لینک یا دکمه‌ای کلاس fl-favorite-btn و شناسه نوشته را بدهید. افزونه کلیک را مدیریت می‌کند و تصویر داخل آن را عوض می‌کند."

msgid "Options:"
msgstr "گزینه‌ها:"

msgid "For developers"
msgstr "برای توسعه‌دهندگان"

msgid "Whether a post is in the current user’s favorites."
msgstr "آیا نوشته در لیست علاقه مندی کاربر فعلی هست یا نه."

msgid "URL of the normal or active icon."
msgstr "آدرس آیکون عادی یا فعال."

msgid "Filter: post types that can be favorited (default: posts)."
msgstr "فیلتر: نوع‌های نوشته‌ای که می‌توانند به علاقه مندی اضافه شوند (پیش‌فرض: نوشته‌ها)."

